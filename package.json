{
  "name": "blackrock-th",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": "Maximilien Zaleski",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm --prefix src/frontend run build && tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "tsx --test 'src/*.test.ts'",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "postinstall": "npm --prefix src/frontend install",
    "prestart": "npm run build",
    "audit:all": "npm audit; status=$?; npm --prefix src/frontend audit && exit $status",
    "clean": "node -e \"for (const p of ['dist', 'node_modules', 'src/frontend/dist', 'src/frontend/node_modules', 'coverage', 'src/frontend/coverage']) require('node:fs').rmSync(p, { recursive: true, force: true })\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ical-generator": "^11.1.2"
  }
}
